{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "reset_password — несуществующий email возвращает ok",
      "method": "POST",
      "path": "/?action=reset_password",
      "body": {"email": "nonexistent_test_user_xyz@example.com"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "reset_password — невалидный email",
      "method": "POST",
      "path": "/?action=reset_password",
      "body": {"email": "notanemail"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "oauth_url — неизвестный провайдер",
      "method": "POST",
      "path": "/?action=oauth_url",
      "body": {"provider": "unknown", "redirect_uri": "https://example.com/oauth"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "oauth_callback — пустой код",
      "method": "POST",
      "path": "/?action=oauth_callback",
      "body": {"provider": "vk", "code": ""},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "oauth_callback — vk без code_verifier",
      "method": "POST",
      "path": "/?action=oauth_callback",
      "body": {"provider": "vk", "code": "somecode", "redirect_uri": "https://example.com/oauth"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "delete_account — без авторизации возвращает 401",
      "method": "POST",
      "path": "/?action=delete_account",
      "body": {},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "login — неверные данные возвращают 401",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "nonexistent_test_user_xyz@example.com", "password": "wrongpass123"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "me — без токена возвращает 401",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    }
  ]
}